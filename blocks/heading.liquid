{%- comment -%}
  Reusable heading/subheading theme block.
  Type is derived from this filename ("heading") — referenceable from any
  section's schema as {"type": "heading"}, either as a normal addable block
  or, as in sections/app-widgets.liquid, as a fixed static block:
    "blocks": [{ "type": "heading", "id": "header", "static": true }]
    ... rendered via: {% content_for 'block', type: 'heading', id: 'header' %}
{%- endcomment -%}

{%- doc -%}
  @param {string} id - The id of block
{%- enddoc -%}

{%- liquid
  assign alignment_class = 'theme-heading--vertical'
  if block.settings.alignment == 'horizontal'
    assign alignment_class = 'theme-heading--horizontal'
  endif
-%}

{% style %}
  #ThemeHeading-{{ block.id }} {
    margin-bottom: {{ block.settings.header_spacing_bottom }}px;
  }

  #ThemeHeading-{{ block.id }} .theme-heading__heading {
    font-size: {{ block.settings.heading_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    #ThemeHeading-{{ block.id }} .theme-heading__heading {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }
{% endstyle %}

{%- if block.settings.heading != blank or block.settings.subheading != blank -%}
  <div id="ThemeHeading-{{ block.id }}" class="theme-heading theme-heading--vertical" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h2 class="theme-heading__heading section-heading">{{ block.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if block.settings.subheading != blank -%}
      {%- capture subheading_inner -%}
        {%- if block.settings.subheading_icon_start != blank -%}
          <span class="theme-heading__icon" aria-hidden="true">{{ block.settings.subheading_icon_start }}</span>
        {%- endif -%}
        <span class="theme-heading__subheading-text">{{ block.settings.subheading | escape }}</span>
        <span class="theme-heading__icon heading__icon-after" aria-hidden="true">
          {%- if block.settings.subheading_icon_end != blank -%}
            {{ block.settings.subheading_icon_end }}
          {%- else -%}
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 6 6 6-6 6"/></svg>
          {%- endif -%}
        </span>
      {%- endcapture -%}

      {%- if block.settings.subheading_link != blank -%}
        <a href="{{ block.settings.subheading_link }}" class="theme-heading__subheading">{{ subheading_inner }}</a>
      {%- else -%}
        <div class="theme-heading__subheading">{{ subheading_inner }}</div>
      {%- endif -%}
    {%- endif -%}

    <div class="section__desc">{{ block.settings.description | default: 'Join our community for daily skincare inspiration and an exclusive look at our science-backed creations.' }}</div>
    
    </div>
{%- endif -%}

{% stylesheet %}
  .theme-heading {
    display: flex;
    gap: var(--space-3, 12px);
  }

  .theme-heading--vertical {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .theme-heading--horizontal {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    text-align: left;
  }

  .theme-heading__heading {
    margin: 0;
    line-height: 1.15;
  }

  .theme-heading__subheading {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    font-weight: 500;
    flex-shrink: 0;
    gap: 12px;
    font-family: var(--font-heading);
    font-size: 30px;
    color: var(--color-primary);
  }

  span.theme-heading__subheading-text {
    line-height: 1;
    margin-bottom: 4px;
}

  .section__desc {
    max-width: 480px;
    margin: 0 auto;
    color: #55636b;
  }

  .theme-heading__icon {
    display: inline-flex;
    align-items: center;
  }
  .heading__icon-after {
    width: 20px;
    height: 20px;
  }
  .heading__icon-after svg {
    width: 100%;
    height: 100%;
  }
  @media (max-width: 767px) {
    .theme-heading__subheading {
      font-size: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop)",
      "min": 16,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 14,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading text"
    },
    {
      "type": "url",
      "id": "subheading_link",
      "label": "Subheading link",
      "info": "Optional. Makes the subheading row clickable."
    },
    {
      "type": "liquid",
      "id": "subheading_icon_start",
      "label": "Icon — before text",
      "info": "Raw SVG or Liquid. Leave blank for no icon."
    },
    {
      "type": "liquid",
      "id": "subheading_icon_end",
      "label": "Icon — after text",
      "info": "Raw SVG or Liquid. Leave blank to use the default chevron."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
        "type": "richtext",
        "id": "description",
        "label": "Short description"
    },
    {
      "type": "range",
      "id": "header_spacing_bottom",
      "label": "Space below header",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    { "name": "Heading" }
  ]
}
{% endschema %}
