{%- comment -%}
  Purpose-built for the "quality, reliability, sustainability" about-page
  paragraph — segmented into a scannable 3-pillar grid rather than a wall
  of text. Block content below is your exact wording, split by idea; only
  the short pillar titles are new (added for scannability, not in your
  original copy) — reword or drop any of them from the theme editor.
{%- endcomment -%}

{%- liquid
  assign scheme_class = 'color-' | append: section.settings.color_scheme
-%}

<section
  class="brand-values {{ scheme_class }}"
  style="
    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="brand-values__header text-center">
        <h2 class="h-section">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="brand-values__grid">
      {%- for block in section.blocks -%}
        <div class="brand-values__item" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="brand-values__item-title">{{ block.settings.title }}</h3>
          {%- endif -%}
          <div class="brand-values__item-text body-text text-muted">
            {{ block.settings.text }}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .brand-values {
    padding-top: var(--padding-top-mobile);
    padding-bottom: var(--padding-bottom-mobile);
  }

  @media (min-width: 750px) {
    .brand-values {
      padding-top: var(--padding-top-desktop);
      padding-bottom: var(--padding-bottom-desktop);
    }
  }

  .brand-values__header {
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-7, 2.5rem);
  }

  .brand-values__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-6, 2rem);
  }

  .brand-values__item {
    text-align: center;
  }

  .brand-values__item-title {
    margin: 0 0 var(--space-3, 0.75rem);
  }

  .brand-values__item-text {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand values",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "At Shivora, we believe in quality, reliability, and sustainability."
    },
    {
      "type": "header",
      "content": "Padding — desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    },
    {
      "type": "header",
      "content": "Padding — mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "title": "Quality & purpose",
            "text": "<p>We understand that skincare is not merely a routine practice; it's about giving the skin a delightful treat.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Eco-friendly packaging",
            "text": "<p>As an eco-friendly beauty brand in Pakistan, we believe in delivering our products in minimal, recyclable, and ecological packaging.</p>"
          }
        },
        {
          "type": "value",
          "settings": {
            "title": "Organic & affordable",
            "text": "<p>We are determined to our organic skincare mission and are dedicated to presenting pure, organic but affordable skincare products to Pakistani consumers. We are committed to empowering you and making you feel confident in your skin.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
