<section class="blogs-section">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading | default: 'Blogs' }}</h2>

    <div class="blog-grid">
      {%- assign blog = blogs[section.settings.blog] -%}
      {%- if blog != blank and blog.articles.size > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <article class="blog-card">
            <a class="blog-card__media" href="{{ article.url }}">
              {%- if article.image -%}
                {{ article.image | image_url: width: 700 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag }}
              {%- endif -%}
            </a>
            <div class="blog-card__body">
              <h3 class="blog-card__title">{{ article.title }}</h3>
              <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 100 }}</p>
              <a class="blog-card__link" href="{{ article.url }}">Read More</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="blog-card">
            <span class="blog-card__media">{{ 'lifestyle-2' | placeholder_svg_tag }}</span>
            <div class="blog-card__body">
              <h3 class="blog-card__title">Discover Natural Skincare Secrets</h3>
              <p class="blog-card__excerpt">Explore expert skincare tips, ingredient insights, and simple routines...</p>
              <a class="blog-card__link" href="#">Read More</a>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if blog != blank -%}
      <p class="blogs-section__cta">
        <a href="{{ blog.url }}" class="button button--dark">{{ section.settings.view_all_label | default: 'View all' }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Blogs"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "\"View all\" button label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}
