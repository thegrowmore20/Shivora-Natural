{% comment %}
  Shivora Brand Promise Section
{% endcomment %}

<section 
  class="section sh-brand-promise"
  style="
    padding-top: {{ section.settings.padding_top_desktop }}px;
    padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
  "
>
  <div class="page-width">

    <div class="sh-brand-promise__wrapper">

      {% for block in section.blocks %}

        {% case block.type %}

        {% when 'heading' %}

          <h2 class="h2 section-heading" {{ block.shopify_attributes }}>
            {{ block.settings.heading }}
          </h2>


        {% when 'text' %}

          <div class="rte sh-brand-promise__text"
          {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>


        {% when 'button' %}

          {% if block.settings.button_label != blank %}

          <a 
            href="{{ block.settings.button_link }}"
            class="button button--accent"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.button_label }}
          </a>

          {% endif %}

        {% endcase %}

      {% endfor %}

    </div>

  </div>
</section>


<style>

.sh-brand-promise__wrapper{
  max-width:850px;
  margin:auto;
  text-align:center;
}

.sh-brand-promise__wrapper h2{
  margin-bottom:25px;
}

.sh-brand-promise__text{
  font-size:16px;
  line-height:1.8;
}


@media(max-width:749px){

.sh-brand-promise{
 padding-top:{{ section.settings.padding_top_mobile }}px !important;
 padding-bottom:{{ section.settings.padding_bottom_mobile }}px !important;
}

.sh-brand-promise__text{
 font-size:15px;
}

}

</style>


{% schema %}
{
"name":"Shivora Brand Promise",
"settings":[

{
"type":"range",
"id":"padding_top_desktop",
"label":"Desktop Top Padding",
"default":70,
"min":0,
"max":150,
"step":5
},

{
"type":"range",
"id":"padding_bottom_desktop",
"label":"Desktop Bottom Padding",
"default":70,
"min":0,
"max":150,
"step":5
},

{
"type":"range",
"id":"padding_top_mobile",
"label":"Mobile Top Padding",
"default":40,
"min":0,
"max":100,
"step":5
},

{
"type":"range",
"id":"padding_bottom_mobile",
"label":"Mobile Bottom Padding",
"default":40,
"min":0,
"max":100,
"step":5
}

],

"blocks":[

{
"type":"heading",
"name":"Heading",
"settings":[
{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Quality, Reliability & Sustainability"
}
]
},

{
"type":"text",
"name":"Content",
"settings":[

{
"type":"richtext",
"id":"text",
"label":"Content"
}

]
},

{
"type":"button",
"name":"Button",
"settings":[

{
"type":"text",
"id":"button_label",
"label":"Button Text"
},

{
"type":"url",
"id":"button_link",
"label":"Button Link"
}

]
}

],

"presets":[
{
"name":"Shivora Brand Promise"
}
]

}
{% endschema %}