<section class="faq-support">
  <div class="container">
    <div class="faq-support__grid">
      <div class="faq-support__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="faq-support__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="faq-support__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="faq-support__subtext">
            {{ section.settings.subtext }}
            {%- if section.settings.contact_link != blank -%}
              <a href="{{ section.settings.contact_link }}" class="faq-support__link">{{ section.settings.contact_link_label | default: 'Contact us' }}</a>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if section.settings.phone != blank or section.settings.email != blank or section.settings.hours != blank -%}
          <div class="faq-support__card">
            <p class="faq-support__card-title">
              {% render 'icon', name: 'phone' %}
              {{ section.settings.card_heading | default: 'Contact Information' }}
            </p>

            {%- if section.settings.phone != blank -%}
              <div class="faq-support__row">
                <span class="faq-support__label">Phone</span>
                <a href="tel:{{ section.settings.phone | remove: ' ' }}" class="faq-support__value">{{ section.settings.phone }}</a>
              </div>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <div class="faq-support__row">
                <span class="faq-support__label">Email</span>
                <a href="mailto:{{ section.settings.email }}" class="faq-support__value">{{ section.settings.email }}</a>
              </div>
            {%- endif -%}

            {%- if section.settings.hours != blank or section.settings.address != blank -%}
              <div class="faq-support__hours">
                {% render 'icon', name: 'clock' %}
                <span>
                  {%- if section.settings.hours != blank -%}{{ section.settings.hours }}<br>{%- endif -%}
                  {%- if section.settings.address != blank -%}{{ section.settings.address }}{%- endif -%}
                </span>
              </div>
            {%- endif -%}

            {%- if section.settings.response_time != blank -%}
              <p class="faq-support__meta"><span class="faq-support__dot"></span>Avg. response time: <strong>{{ section.settings.response_time }}</strong></p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="faq-support__list">
        {%- for block in section.blocks -%}
          {%- if block.settings.answer != blank -%}
            {%- render 'accordion-item', title: block.settings.question, content: block.settings.answer -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ + Support",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Can't find what you're looking for? Reach out to our team directly."
    },
    {
      "type": "text",
      "id": "contact_link_label",
      "label": "Contact link label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "header",
      "content": "Contact card"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading",
      "default": "Contact Information"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Hours"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Average response time",
      "default": "24h"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ + Support",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
