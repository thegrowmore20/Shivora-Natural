{%- comment -%}
  First-time-visitor discount popup, rendered once from layout/theme.liquid
  so it appears on every page. Shown only on a visitor's first page load ever
  (tracked via localStorage — see DiscountPopup in assets/global.js), and
  dismissible via the close button, an overlay click, or submitting the form.

  Email capture uses Shopify's native customer form (adds the shopper to
  your customer list, tagged "newsletter,discount-popup"), so no app is
  required. The discount code itself is just a static setting shown after
  signup — create a matching discount code of that name in Shopify Admin >
  Discounts for it to actually work at checkout.
{%- endcomment -%}
<div class="discount-popup" data-discount-popup hidden>
  <div class="discount-popup__overlay" data-discount-popup-dismiss></div>
  <div class="discount-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="DiscountPopupHeading">
    <button type="button" class="discount-popup__close" data-discount-popup-dismiss aria-label="Close">
      {% render 'icon', name: 'plus' %}
    </button>

    <div class="discount-popup__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
      {%- endif -%}
    </div>

    <div class="discount-popup__content">
      <h2 class="discount-popup__heading" id="DiscountPopupHeading">{{ section.settings.heading | default: "Get 15% Off Your First Order" }}</h2>

      {%- if section.settings.subtext != blank -%}
        <p class="discount-popup__label" style="text-transform:none;font-weight:400;color:#55636b;">{{ section.settings.subtext }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'DiscountPopupForm', class: 'discount-popup__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="review-form__success">
            You're in! Use code <strong>{{ section.settings.discount_code | default: 'WELCOME15' }}</strong> at checkout.
          </p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter,discount-popup">
          <input
            type="email"
            name="contact[email]"
            class="discount-popup__select"
            placeholder="Email Address"
            required
            style="text-transform:none;"
          >
          <button type="submit" class="button button--accent discount-popup__submit">
            {{ section.settings.button_label | default: 'Claim My Discount' }}
          </button>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.terms_text != blank -%}
        <p class="discount-popup__contact">{{ section.settings.terms_text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Discount popup",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 15% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sign up for our newsletter and get an exclusive discount code sent straight to your inbox."
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount code to display",
      "info": "Create a matching discount code in Shopify Admin > Discounts",
      "default": "WELCOME15"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Claim My Discount"
    },
    {
      "type": "text",
      "id": "terms_text",
      "label": "Fine print (optional)",
      "default": "Valid on your first order only. Cannot be combined with other offers."
    }
  ]
}
{% endschema %}
