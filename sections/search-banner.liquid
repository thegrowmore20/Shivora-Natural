<section class="shop-banner shop-banner--plain">
  <div class="container">
    {%- if search.performed -%}
      <h1 class="shop-banner__heading">Search Results</h1>
      <div class="shop-banner__text">
        {%- if search.results_count > 0 -%}
          <p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for &ldquo;{{ search.terms }}&rdquo;</p>
        {%- else -%}
          <p>No results found for &ldquo;{{ search.terms }}&rdquo;</p>
        {%- endif -%}
      </div>
    {%- else -%}
      <h1 class="shop-banner__heading">Search</h1>
    {%- endif -%}

    <form action="{{ routes.search_url }}" method="get" class="shop-banner__search" role="search">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search products"
        aria-label="Search products"
      >
      <button type="submit" aria-label="Search">{% render 'icon', name: 'search' %}</button>
    </form>
  </div>
</section>

{% schema %}
{
  "name": "Search banner",
  "settings": [],
  "presets": [
    {
      "name": "Search banner"
    }
  ]
}
{% endschema %}
