<section class="instagram-section">
  <div class="container">
    <h2 class="section-heading" style="margin-bottom:0;">{{ section.settings.heading | default: 'Follow Us on Instagram' }}</h2>
    <p class="instagram-section__handle">
      {% render 'icon', name: 'instagram' %}
      {{ section.settings.handle | default: '@shivoranatural.official' }}
    </p>
    <p class="instagram-section__desc">{{ section.settings.description | default: 'Join our community for daily skincare inspiration and an exclusive look at our science-backed creations.' }}</p>

    <div class="instagram-grid">
      {%- for block in section.blocks -%}
        <a class="instagram-grid__item" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
          <span class="instagram-grid__play">{% render 'icon', name: 'play' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Us on Instagram"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle",
      "default": "@shivoranatural.official"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Join our community for daily skincare inspiration and an exclusive look at our science-backed creations."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
