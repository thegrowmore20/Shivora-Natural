<section class="product">
  <div class="container">
    <nav class="breadcrumb" aria-label="breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="breadcrumb__sep">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a>
        <span class="breadcrumb__sep">/</span>
      {%- endif -%}
      <span class="breadcrumb__current">{{ product.title }}</span>
    </nav>

    <div class="product__grid">
      <div class="product__media">
        {%- if product.media.size > 0 -%}
          <div class="product-gallery" data-product-gallery>
            {%- if product.media.size > 1 -%}
              <div class="product-gallery__thumbs">
                {%- for media in product.media -%}
                  <button type="button" class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb data-index="{{ forloop.index0 }}" data-media-id="{{ media.id }}" aria-label="Show image {{ forloop.index }}">
                    {{ media | image_url: width: 160 | image_tag: loading: 'lazy' }}
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="product-gallery__viewer">
              {%- if product.media.size > 1 -%}
                <button type="button" class="product-gallery__nav product-gallery__nav--prev" data-gallery-prev aria-label="Previous image">{% render 'icon', name: 'chevron-left' %}</button>
              {%- endif -%}

              <div class="product-gallery__stage">
                {%- for media in product.media -%}
                  {%- assign loading_attr = 'lazy' -%}
                  {%- if forloop.first -%}{%- assign loading_attr = 'eager' -%}{%- endif -%}
                  <div class="product-gallery__slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide data-index="{{ forloop.index0 }}">
                    {{ media | image_url: width: 1200 | image_tag: loading: loading_attr, widths: '400, 600, 900, 1200', alt: media.alt }}
                  </div>
                {%- endfor -%}
              </div>

              {%- if product.media.size > 1 -%}
                <button type="button" class="product-gallery__nav product-gallery__nav--next" data-gallery-next aria-label="Next image">{% render 'icon', name: 'chevron-right' %}</button>
              {%- endif -%}

              <a class="product-gallery__expand" data-gallery-expand href="{{ product.featured_image | image_url: width: 2000 }}" target="_blank" rel="noopener" aria-label="View full-size image">
                {% render 'icon', name: 'expand' %}
              </a>
            </div>
          </div>
        {%- else -%}
          <div class="product-gallery__slide is-active">{{ 'product-1' | placeholder_svg_tag }}</div>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- capture product_form_id -%}ProductForm-{{ section.id }}{%- endcapture -%}
        {%- form 'product', product, id: product_form_id -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-product-variant-id>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <p class="product__vendor" {{ block.shopify_attributes }}>{{ product.vendor }}</p>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

              {%- when 'rating' -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  {% render 'star-rating', rating: block.settings.average_rating %}
                  <span class="product__rating-count">{{ block.settings.review_count }} reviews</span>
                </div>

              {%- when 'price' -%}
                <div class="product__price" data-product-price {{ block.shopify_attributes }}>
                  <span class="product__price-current" data-product-price-current>{{ product.selected_or_first_available_variant.price | money }}</span>
                  {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                    <span class="product__price-compare" data-product-price-compare>{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
                  {%- else -%}
                    <span class="product__price-compare" data-product-price-compare hidden></span>
                  {%- endif -%}
                  {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
                    {%- assign pct = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price | times: 100.0 | divided_by: product.selected_or_first_available_variant.compare_at_price | round -%}
                    <span class="product__badge" data-product-badge>-{{ pct }}%</span>
                  {%- else -%}
                    <span class="product__badge" data-product-badge hidden></span>
                  {%- endif -%}
                </div>

              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <div class="product__variants" data-variant-picker {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                      {%- assign option_index = option.position | minus: 1 -%}
                      <div class="product__option">
                        <p class="product__option-label">{{ option.name }}: <span data-option-selected>{{ option.selected_value }}</span></p>
                        <div class="product__option-values">
                          {%- for value in option.values -%}
                            {%- assign swatch_image = blank -%}
                            {%- for variant in product.variants -%}
                              {%- if variant.options[option_index] == value and variant.featured_image -%}
                                {%- assign swatch_image = variant.featured_image -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- assign input_id = option.name | append: '-' | append: value | append: '-' | append: section.id | handle -%}
                            <input
                              type="radio"
                              class="product__option-radio"
                              name="option-{{ option_index }}-{{ section.id }}"
                              id="{{ input_id }}"
                              value="{{ value | escape }}"
                              data-option-index="{{ option_index }}"
                              {% if option.selected_value == value %}checked{% endif %}
                            >
                            <label class="product__swatch{% if swatch_image == blank %} product__swatch--text{% endif %}" for="{{ input_id }}">
                              {%- if swatch_image != blank -%}
                                {{ swatch_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: value }}
                              {%- else -%}
                                <span>{{ value }}</span>
                              {%- endif -%}
                            </label>
                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endfor -%}
                  </div>

                  <script type="application/json" data-variant-data>
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id | json }},
                          "options": {{ variant.options | json }},
                          "available": {{ variant.available | json }},
                          "price": {{ variant.price | money | json }},
                          "compare_at_price": {{ variant.compare_at_price | money | json }},
                          "compare_at_price_raw": {{ variant.compare_at_price | json }},
                          "price_raw": {{ variant.price | json }},
                          "featured_media_id": {{ variant.featured_media.id | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  </script>
                {%- endunless -%}

              {%- when 'short_description' -%}
                {%- assign short_description = product.description | strip_html | strip_newlines | truncatewords: 40 -%}
                {%- if short_description != blank -%}
                  <p class="product__short-description" {{ block.shopify_attributes }}>{{ short_description }}</p>
                {%- endif -%}

              {%- when 'buy_buttons' -%}
                {%- assign next_block = section.blocks[forloop.index] -%}
                {%- if next_block.type == 'quantity' -%}<div class="product__purchase-row">{%- endif -%}
                <div class="product__buy-row" {{ block.shopify_attributes }}>
                  <button type="submit" class="button button--accent product__add-to-cart" data-product-add-to-cart {% unless product.available %}disabled{% endunless %}>
                    {% render 'icon', name: 'cart' %}
                    <span data-product-add-to-cart-label>{%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}</span>
                  </button>
                </div>

              {%- when 'quantity' -%}
                {%- assign prev_index = forloop.index0 | minus: 1 -%}
                {%- assign prev_block = section.blocks[prev_index] -%}
                <div class="quantity-selector" data-quantity-selector {{ block.shopify_attributes }}>
                  <button type="button" data-quantity-minus aria-label="Decrease quantity">{% render 'icon', name: 'minus' %}</button>
                  <input type="number" id="Quantity-{{ section.id }}" class="quantity-selector__input" name="quantity" value="1" min="1" inputmode="numeric" aria-label="Quantity">
                  <button type="button" data-quantity-plus aria-label="Increase quantity">{% render 'icon', name: 'plus' %}</button>
                </div>
                {%- if prev_block.type == 'buy_buttons' -%}</div>{%- endif -%}

                {%- capture dynamic_checkout_html -%}
                  {%- if block.settings.show_dynamic_checkout and product.available -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endcapture -%}
                {%- assign dynamic_checkout_html = dynamic_checkout_html | strip -%}

                {%- if dynamic_checkout_html != blank or block.settings.show_wishlist -%}
                  <div class="product__secondary-row">
                    {%- if dynamic_checkout_html != blank -%}
                      <div class="product__dynamic-checkout">{{ dynamic_checkout_html }}</div>
                    {%- endif -%}
                    {%- if block.settings.show_wishlist -%}
                      {% comment %} <button type="button" class="product__icon-btn" aria-label="Add to wishlist">
                        {% render 'icon', name: 'heart' %}
                      </button> {% endcomment %}
                      {% render 'wishlist-button' %}
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'addons' -%}
                {%- assign addon_products = product.metafields.custom.addons.value -%}
                {%- if addon_products != blank -%}
                  <div class="product__addons" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <p class="product__addons-heading">{{ block.settings.heading }}</p>
                    {%- endif -%}
                    <div class="product__addons-list">
                      {%- for addon in addon_products -%}
                        <a href="{{ addon.url }}" class="product__addon">
                          {{ addon.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'product__addon-image' }}
                          <span class="product__addon-info">
                            <span class="product__addon-title">{{ addon.title }}</span>
                          </span>
                          <span class="product__addon-price">+{{ addon.price | money }}</span>
                        </a>
                      {%- endfor -%}
                    </div>
                  </div>
                {%- endif -%}

              {%- when 'trust_badges' -%}
                <div class="product__trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <p class="product__trust-heading">{{ block.settings.heading }}</p>
                  {%- endif -%}
                  {%- if block.settings.image -%}
                    {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'product__trust-image' }}
                  {%- endif -%}
                </div>

              {%- when 'quick_links' -%}
                <div class="product__quick-links" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.question_link | default: '/pages/contact' }}">
                    {% render 'icon', name: 'question' %} {{ block.settings.question_label }}
                  </a>
                  <button type="button" class="product__share" data-share data-share-title="{{ product.title | escape }}">
                    {% render 'icon', name: 'share' %} {{ block.settings.share_label }}
                  </button>
                </div>
              {%- when 'image' -%}
                {% if block.settings.image != blank %}
                  {% assign alt_text = block.settings.image.alt | default: 'product block image' %}
                  <div class="product__block-image" {{ block.shopify_attributes }}>
                    {{ block.settings.image | image_url: width: 1200 | image_tag:
                      height: block.settings.image.height,
                      alt: alt_text,
                      loading: 'lazy',
                      widths: '750, 990, 1200, 1500, 1920, 2400, 3200'
                    }}
                  </div>
                {% endif %}

              {%- when 'tabs_accordion' -%}
                {%- comment -%}
                  Auto-populated accordion items, collapsed by default. Content
                  sources assume namespace "custom" with snake_case keys
                  matching Shopify's default when a merchant creates a
                  metafield from the admin UI — adjust below if yours differ.
                {%- endcomment -%}
                <div class="product__accordions" {{ block.shopify_attributes }}>
                  {%- if product.description != blank -%}
                    {%- render 'accordion-item', title: 'Description', content: product.description -%}
                  {%- endif -%}

                  {%- assign mf_how_it_works = product.metafields.custom.how_it_works -%}
                  {%- if mf_how_it_works.value != blank -%}
                    {% assign mf_how_it_works_content = mf_how_it_works.value %}
                    {%- render 'accordion-item', title: 'How It Works', content: mf_how_it_works_content -%}
                  {%- endif -%}

                  {%- assign mf_how_to_use = product.metafields.custom.how_to_use -%}
                  {%- if mf_how_to_use.value != blank -%}
                    {%- render 'accordion-item', title: 'How to Use', content: mf_how_to_use.value -%}
                  {%- endif -%}

                  {%- assign mf_who_can_use = product.metafields.custom.who_can_use -%}
                  {%- if mf_who_can_use.value != blank -%}
                    {%- render 'accordion-item', title: 'Who Can Use', content: mf_who_can_use.value -%}
                  {%- endif -%}

                  {%- assign mf_caution = product.metafields.custom.caution -%}
                  {%- if mf_caution.value != blank -%}
                    {%- render 'accordion-item', title: 'Caution', content: mf_caution.value -%}
                  {%- endif -%}

                  {%- assign mf_beauty_gains = product.metafields.custom.beauty_gains -%}
                  {%- if mf_beauty_gains.value != blank -%}
                    {%- render 'accordion-item', title: 'Beauty Gains', content: mf_beauty_gains.value -%}
                  {%- endif -%}
                </div>

              {%- when 'custom_tab' -%}
                {%- if block.settings.content != blank -%}
                  <div class="product__accordions {{ forloop.index }}" {{ block.shopify_attributes }}>
                    {%- render 'accordion-item-custom', title: block.settings.title, content: block.settings.content -%}
                  </div>
                {%- endif -%}

                <script>
                  document.addEventListener('DOMContentLoaded', function () {
                    const accordions = document.querySelectorAll('.product__accordions .accordion-item');

                    if (!accordions.length) return;

                    accordions.forEach((accordion) => {
                      const trigger = accordion.querySelector('.accordion-item__summary');
                      const wrapper = accordion.querySelector('.accordion-item__content-wrapper');

                      if (!trigger || !wrapper) return;


                      // Initial opened accordion
                      if (accordion.classList.contains('active')) {
                        wrapper.style.maxHeight = wrapper.scrollHeight + 'px';
                      } else {
                        wrapper.style.maxHeight = '0px';
                      }


                      trigger.addEventListener('click', function () {

                        const isActive = accordion.classList.contains('active');


                        // Close all others
                        accordions.forEach((item) => {
                          if (item !== accordion && item.classList.contains('active')) {

                            item.classList.remove('active');

                            const itemWrapper = item.querySelector('.accordion-item__content-wrapper');

                            if (itemWrapper) {
                              itemWrapper.style.maxHeight = '0px';
                            }
                          }
                        });


                        // Toggle current
                        if (isActive) {

                          accordion.classList.remove('active');
                          wrapper.style.maxHeight = '0px';

                        } else {

                          accordion.classList.add('active');
                          wrapper.style.maxHeight = wrapper.scrollHeight + 'px';

                        }

                      });
                    });
                  });
                </script> 

            {%- endcase -%}
          {%- endfor -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

<div class="sticky-atc" data-sticky-atc>
  <div class="sticky-atc__inner">

    <div class="sticky-atc__product">
      <img
        src="{{ product.featured_image | image_url: width: 120 }}"
        alt="{{ product.title }}"
        loading="lazy"
      >

      <div class="sticky-atc__info">
        <p>{{ product.title }}</p>
        <span>{{ product.price | money }}</span>
      </div>
    </div>


    <button 
      type="button"
      class="sticky-atc__button button button--accent"
      data-sticky-atc-button
      {% unless product.available %}disabled{% endunless %}
    >
      {% if product.available %}
        Add to Cart
      {% else %}
        Sold Out
      {% endif %}
    </button>

  </div>
</div>

{% style %}
  .sticky-atc {
  position: fixed;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%) translateY(120%);
  width: min(550px, calc(100% - 32px));
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 10px 35px rgba(0,0,0,.15);
  z-index: 999;
  transition: .3s ease;
  opacity:0;
  visibility:hidden;
}

.sticky-atc.is-visible {
  transform: translateX(-50%) translateY(0);
  opacity:1;
  visibility:visible;
}


.sticky-atc__inner {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  padding:12px;
}


.sticky-atc__product {
  display:flex;
  align-items:center;
  gap:12px;
}


.sticky-atc__product img {
  width:55px;
  height:55px;
  object-fit:cover;
  border-radius:8px;
}


.sticky-atc__info p {
  margin:0;
  font-size:14px;
  font-weight:600;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}


.sticky-atc__info span {
  font-size:13px;
}


.sticky-atc__button {
  border: 2px solid transparent;
  padding: 9px 35px;
  cursor:pointer;
  white-space: nowrap;
}


.sticky-atc__button:disabled {
  opacity:.5;
  cursor:not-allowed;
}



@media(max-width:749px){
  body:has(.sticky-atc.is-visible) {
    padding-bottom: 60px;
  }
  .sticky-atc {
    width: 100%;
    bottom: 0px;
    border-radius: 0;
  }
  .sticky-atc__product {
    display: none;
  }
  .sticky-atc__inner {
    gap:10px;
  }
  .sticky-atc__info p {
    max-width:150px;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .sticky-atc__button {
    padding: 9px 18px;
    width: 100%;
  }
  .sticky-atc__inner {
    padding: 8px
  }
}
{% endstyle %}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-product",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "settings": [
        {
          "type": "number",
          "id": "average_rating",
          "label": "Average rating",
          "default": 4.7
        },
        {
          "type": "number",
          "id": "review_count",
          "label": "Review count",
          "default": 34
        }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "short_description",
      "name": "Short description",
      "settings": []
    },
    {
      "type": "buy_buttons",
      "name": "Add to cart button",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "Quantity + Buy it now",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button (Buy it now)",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_wishlist",
          "label": "Show wishlist button",
          "default": true
        }
      ]
    },
    {
      "type": "addons",
      "name": "Addons",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Frequently Added Together"
        }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Guarantee Safe Checkout:"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Payment icons image"
        }
      ]
    },
    {
      "type": "quick_links",
      "name": "Ask a question / Share",
      "settings": [
        {
          "type": "text",
          "id": "question_label",
          "label": "Ask a question label",
          "default": "Ask a question"
        },
        {
          "type": "url",
          "id": "question_link",
          "label": "Ask a question link"
        },
        {
          "type": "text",
          "id": "share_label",
          "label": "Share label",
          "default": "Share"
        }
      ]
    },
    {
      "type": "image",
      "name": "Block image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "tabs_accordion",
      "name": "Tabs (auto)",
      "settings": []
    },
    {
      "type": "custom_tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping and Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "rating" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "short_description" },
        { "type": "addons" },
        { "type": "buy_buttons" },
        { "type": "quantity" },
        { "type": "trust_badges" },
        { "type": "quick_links" },
        { "type": "tabs_accordion" },
        { "type": "custom_tab", "settings": { "title": "Shipping and Returns" } },
        { "type": "custom_tab", "settings": { "title": "Return Policies" } }
      ]
    }
  ]
}
{% endschema %}
