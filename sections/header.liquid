<style>
  /* Desktop nav only */
  .header__nav { display: none; }
  
  @media screen and (min-width: 990px) {
    .header__nav { display: flex; align-items: center; gap: 36px; }
    .header__menu-toggle { display: none; }
    .mdrawer, .mdrawer-overlay { display: none; }
  }
  
  /* Mobile drawer */
  body:has(.mdrawer.is-open) { overflow: hidden; }
  
  .mdrawer-overlay {
    position: fixed; inset: 0; z-index: 190;
    background: rgba(21, 51, 66, 0.5);
    opacity: 0; pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .mdrawer-overlay.is-open { opacity: 1; pointer-events: auto; }
  
  .mdrawer {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 200;
    width: 86%; max-width: 360px;
    display: flex; flex-direction: column;
    background: #fff;
    transform: translateX(-100%);
    visibility: hidden;
    transition: transform 0.3s ease, visibility 0s linear 0.3s;
  }
  .mdrawer.is-open {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.3s ease, visibility 0s;
  }
  
  .mdrawer__head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-surface);
  }
  .mdrawer__brand { color: var(--color-primary); text-decoration: none; }
  .mdrawer__brand img { display: block; height: 36px; width: auto; }
  
  .mdrawer__close {
    width: 32px; height: 32px; border: 0; border-radius: 50%;
    background: var(--color-surface);
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .mdrawer__close svg { width: 20px; height: 20px; transform: rotate(45deg); }
  
  .mdrawer__body { flex: 1; overflow-y: auto; padding: 4px 20px; }
  .mdrawer__list, .mdrawer__sub { list-style: none; margin: 0; padding: 0; }
  .mdrawer__sub { padding-left: 14px; }
  
  .mdrawer__link {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0;
    font-size: 16px; color: var(--color-primary); text-decoration: none;
    border-bottom: 1px solid var(--color-surface);
    cursor: pointer;
  }
  .mdrawer__link--child { 
    font-size: 15px;
    display: -webkit-box;
    overflow: hidden;
    text-overflow: ellipsis;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .mdrawer__link--sub { font-size: 14px; opacity: 0.85; }
  
  .mdrawer__details > summary { list-style: none; }
  .mdrawer__details > summary::-webkit-details-marker { display: none; }
  .mdrawer__details > summary svg { transition: transform 0.2s ease; }
  .mdrawer__details[open] > summary svg { transform: rotate(180deg); }
  
  .mdrawer__social {
    display: flex; gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid var(--color-surface);
  }
  .mdrawer__social a {
    width: 40px; height: 40px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    background: var(--color-surface); color: var(--color-primary);
  }
  .mdrawer__social svg { width: 18px; height: 18px; }
</style>

<header class="header">
  <div class="container header__inner">
    <button class="header__menu-toggle" aria-label="Menu" type="button" data-drawer-open aria-controls="mobile-drawer" aria-expanded="false">
      {% render 'icon', name: 'menu' %}
    </button>
    
    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo -%}
        <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="{{ section.settings.logo.width }}" height="44">
      {%- else -%}
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="{{ settings.color_secondary }}" stroke-width="1.6"><path d="M6 24c0 6 5 10 11 10s11-4 11-10-5-11-11-11c-4 0-7 3-7 6s3 5 6 5 5-2 5-4"/><circle cx="24" cy="10" r="2" fill="{{ settings.color_secondary }}"/></svg>
        <span class="header__logo-text">
          <strong>{{ section.settings.brand_name | default: 'SHIVORA' }}</strong>
          <span>{{ section.settings.brand_subtitle | default: 'NATURAL' }}</span>
        </span>
      {%- endif -%}
    </a>
    
    {% comment %} <div class="header__nav-overlay" data-nav-dismiss></div> {% endcomment %}
    
    <nav class="header__nav">
      {% comment %} <button type="button" class="header__nav-close" data-nav-dismiss aria-label="Close menu">
      {% render 'icon', name: 'plus' %}
      </button> {% endcomment %}
      
      <a class="header__nav-link" href="{{ routes.root_url }}">Home</a>
      
      {%- for block in section.blocks -%}
        {%- assign menu_collection = collections[block.settings.collection] -%}
        {%- if menu_collection != blank -%}
          <div class="header__nav-item" data-nav-dropdown {{ block.shopify_attributes }}>
            <button type="button" onclick="window.location.href='{{ menu_collection.url }}'" class="header__nav-link header__nav-trigger" data-nav-dropdown-toggle aria-expanded="false">
              {{ block.settings.label }} {% render 'icon', name: 'chevron-down' %}
            </button>
            
            <div class="header__mega" data-nav-dropdown-panel>
              <div class="container header__mega-inner">
                <div class="header__mega-grid">
                  {%- for product in menu_collection.products limit: block.settings.products_to_show -%}
                    {%- comment -%}
                    Rating/count assume the "reviews" metafield namespace used
                    by Shopify's legacy Product Reviews app and several
                    third-party apps that keep compatibility with it
                    (product.metafields.reviews.rating.value /
                    .rating_count.value). If your review app uses a different
                    namespace, swap these two lines out.
                    {%- endcomment -%}
                    {%- assign mega_rating = product.metafields.reviews.rating.value | default: 0 -%}
                    {%- assign mega_rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
                    <a class="header__mega-item" href="{{ product.url }}">
                      <span class="header__mega-media">
                        {%- if product.featured_image -%}
                          {{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy' }}
                        {%- endif -%}
                      </span>
                      <span class="header__mega-title">{{ product.title | truncate: 100 }}</span>
                      <span class="header__mega-rating">
                        
                        {% if product.metafields.judgeme.badge != blank %}
                          <!-- Start of Judge.me code -->
                          <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
                            {{ product.metafields.judgeme.badge }}
                          </div>
                          <!-- End of Judge.me code -->
                        {% else %}
                          {% render 'star-rating', rating: mega_rating %}
                          <span>({{ mega_rating_count }})</span>
                        {% endif %}  
                        
                      </span>
                    </a>
                  {%- endfor -%}
                </div>
                
                {%- if menu_collection.url -%}
                  <div class="header__mega-viewall-wrapper">
                    <a class="header__mega-viewall" href="{{ menu_collection.url }}">
                      {{ block.settings.view_all_label | default: 'View all' }} {% render 'icon', name: 'chevron-right' %}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- else -%}
          <a class="header__nav-link" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
    
    <div class="header__icons">
      <button type="button" data-search-toggle aria-label="Search">{% render 'icon', name: 'search' %}</button>
      {% comment %} <a href="#" aria-label="Wishlist">{% render 'icon', name: 'heart' %}</a> {% endcomment %}
      {% render 'header-wishlist' %}
      <a href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', name: 'account' %}</a>
      <button type="button" class="header__cart" data-cart-toggle aria-label="Cart">
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </div>
</header>

{%- assign drawer_menu = section.settings.drawer_menu -%}
{%- if drawer_menu == blank -%}
  {%- assign drawer_menu = linklists['main-menu'] -%}
{%- endif -%}

<div class="mdrawer-overlay" data-drawer-dismiss></div>

<aside class="mdrawer" id="mobile-drawer" data-drawer aria-label="Menu">
  <div class="mdrawer__head">
    <a href="{{ routes.root_url }}" class="mdrawer__brand">
      {%- if section.settings.logo -%}
        <img src="{{ section.settings.logo | image_url: width: 240 }}" alt="{{ shop.name }}" width="{{ section.settings.logo.width }}" height="36">
      {%- else -%}
        <strong>{{ section.settings.brand_name | default: 'SHIVORA' }}</strong>
      {%- endif -%}
    </a>
    <button type="button" class="mdrawer__close" data-drawer-dismiss aria-label="Close menu">
      {% render 'icon', name: 'plus' %}
    </button>
  </div>
  
  <nav class="mdrawer__body">
    <ul class="mdrawer__list">
      {%- for link in drawer_menu.links -%}
        <li>
          {%- if link.links != blank -%}
            <details class="mdrawer__details" {% if forloop.first %}open{% endif %}>
              <summary class="mdrawer__link">
                {%- if link.type == 'collection_link' and link.object -%}
                  {%- assign link_count = link.object.all_products_count | default: link.object.products_count -%}
                {% endif %}
                {{ link.title | append: ' (' | append: link_count | append: ')' }} {% render 'icon', name: 'chevron-down' %}
              </summary>
              <ul class="mdrawer__sub">
                {%- for child in link.links -%}
                  <li>
                    {%- if child.links != blank -%}
                      <details class="mdrawer__details">
                        <summary class="mdrawer__link mdrawer__link--child">
                          {{ child.title }} {% render 'icon', name: 'chevron-down' %}
                        </summary>
                        <ul class="mdrawer__sub">
                          <li><a class="mdrawer__link mdrawer__link--sub" href="{{ child.url }}">All {{ child.title }}</a></li>
                          {%- for sub in child.links -%}
                            <li><a class="mdrawer__link mdrawer__link--sub" href="{{ sub.url }}">{{ sub.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a class="mdrawer__link mdrawer__link--child" href="{{ child.url }}">{{ child.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
                <li>
                  <a class="mdrawer__link mdrawer__link--child" href="{{ link.url }}">
                    <strong>View All</strong>
                  </a>
                </li>
              </ul>
            </details>
          {%- else -%}
            <a class="mdrawer__link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>
  
  {%- if section.settings.social_instagram != blank or section.settings.social_facebook != blank or section.settings.social_tiktok != blank or section.settings.social_youtube != blank -%}
    <div class="mdrawer__social">
      {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_tiktok != blank -%}
        <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
      {%- endif -%}
      {%- if section.settings.social_youtube != blank -%}
        <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</aside>



<script>
  (function () {
    var drawer = document.querySelector('[data-drawer]');
    var overlay = document.querySelector('.mdrawer-overlay');
    var toggle = document.querySelector('[data-drawer-open]');
    if (!drawer || !overlay || !toggle) return;
    
    function openDrawer() {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
    }
    function closeDrawer() {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
    
    toggle.addEventListener('click', openDrawer);
    document.querySelectorAll('[data-drawer-dismiss]').forEach(function (el) {
      el.addEventListener('click', closeDrawer);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeDrawer();
    });
    window.matchMedia('(min-width: 990px)').addEventListener('change', function (e) {
      if (e.matches) closeDrawer();
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "SHIVORA" },
    { "type": "text", "id": "brand_subtitle", "label": "Brand subtitle", "default": "NATURAL" },
    { "type": "header", "content": "Mobile drawer" },
    {
      "type": "link_list",
      "id": "drawer_menu",
      "label": "Drawer menu",
      "info": "Supports up to 3 levels (parent, child, sub-child). Falls back to Main menu if empty."
    },
    { "type": "header", "content": "Drawer social icons" },
    { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
    { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
    { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "social_youtube", "label": "YouTube URL" }
  ],
  "blocks": [
    {
      "type": "dropdown_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop Products"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection to feature",
          "info": "Leave empty to make this a plain link instead of a dropdown"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "label": "Products to show",
          "min": 2,
          "max": 8,
          "step": 1,
          "default": 6
        },
        {
          "type": "text",
          "id": "view_all_label",
          "label": "\"View all\" label",
          "default": "View all"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (used only when no collection is set)"
        }
      ]
    }
  ]
}
{% endschema %}
