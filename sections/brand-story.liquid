<section class="brand-story">
  <div class="container brand-story__grid">
    <div class="brand-story__content">
      <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      <div class="brand-story__text">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--dark">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="brand-story__reels">
      {%- for block in section.blocks -%}
        <div class="reel-card" {{ block.shopify_attributes }}>
          {%- if block.settings.video -%}
            {{
              block.settings.video
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                playsinline: true,
                controls: false,
                image_size: '600x',
                class: 'reel-card__media'
            }}
          {%- elsif block.settings.poster -%}
            {{ block.settings.poster | image_url: width: 600 | image_tag: loading: 'lazy', class: 'reel-card__media' }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'reel-card__media' }}
          {%- endif -%}
          <span class="reel-card__play">{% render 'icon', name: 'play' %}</span>
          {%- if block.settings.caption != blank -%}
            <span class="reel-card__caption">{{ block.settings.caption }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story + reels",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pakistan's Trusted Organic Skincare Brand – Shivora Naturals"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Uploaded directly in the theme editor. Used instead of the poster image when set."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Poster image",
          "info": "Shown when no video is uploaded"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story + reels",
      "blocks": [
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" },
        { "type": "reel" }
      ]
    }
  ]
}
{% endschema %}
