{%- for block in section.blocks -%}
  {%- if block.settings.content != blank -%}
    {%- assign tab_count = tab_count | plus: 1 -%}
    {%- capture this_nav -%}
      <input type="radio" name="product-tabs-{{ section.id }}" id="product-tab-{{ section.id }}-{{ tab_count }}" class="product-tabs__radio"{% if tab_count == 1 %} checked{% endif %} {{ block.shopify_attributes }}>
      <label class="product-tabs__label" for="product-tab-{{ section.id }}-{{ tab_count }}">{{ block.settings.title }}</label>
    {%- endcapture -%}
    {%- assign tabs_nav = tabs_nav | append: this_nav -%}
    {%- capture this_panel -%}
      <div class="product-tabs__panel" id="product-panel-{{ section.id }}-{{ tab_count }}">{{ block.settings.content }}</div>
    {%- endcapture -%}
    {%- assign tabs_panels = tabs_panels | append: this_panel -%}
    {%- capture this_style -%}
      .product-tabs:has(#product-tab-{{ section.id }}-{{ tab_count }}:checked) #product-panel-{{ section.id }}-{{ tab_count }} { display: block; }
    {%- endcapture -%}
    {%- assign tabs_style = tabs_style | append: this_style -%}
  {%- endif -%}
{%- endfor -%}

{%- if tab_count > 0 -%}
  <section class="product-tabs-section">
    <div class="container container--narrow">
      <div class="product-tabs">
        <div class="product-tabs__nav">
          {{ tabs_nav }}
        </div>
        <div class="product-tabs__panels">
          {{ tabs_panels }}
        </div>
      </div>
    </div>
  </section>

  <style>
    {{ tabs_style }}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Product tabs",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shipping and Returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [
        { "type": "tab", "settings": { "title": "Shipping and Returns" } },
        { "type": "tab", "settings": { "title": "Return Policies" } }
      ]
    }
  ]
}
{% endschema %}
