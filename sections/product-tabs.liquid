{%- comment -%}
  CSS-only tabs (no JS): each tab is a hidden radio + label, and the matching
  panel is toggled via `.product-tabs:has(#radio:checked) #panel` (generated
  below), so the radio/label pair can live inside its own scrollable nav
  strip while the panels stay full-width underneath — :has() lets the state
  jump across that boundary instead of relying on strict sibling adjacency.

  Built with capture/append instead of array filters (push/concat), since
  those didn't behave as expected in testing on this store's Liquid runtime.

  Content sources, in order:
    1. Description  — product.description (always shown, if present)
    2. Metafields    — How It Works / How to Use / Who Can Use / Caution /
                        Beauty Gains, each shown only when filled. These
                        assume namespace "custom" with snake_case keys
                        matching the field label (Shopify's default when a
                        merchant creates a metafield from the admin UI) —
                        adjust the keys below if your store's differ.
    3. Section blocks — e.g. "Shipping and Returns", "Return Policies",
                        editable from the theme editor, shown only when the
                        block has content.
{%- endcomment -%}

{%- assign tab_count = 0 -%}
{%- capture tabs_nav -%}{%- endcapture -%}
{%- capture tabs_panels -%}{%- endcapture -%}
{%- capture tabs_style -%}{%- endcapture -%}

{%- if product.description != blank -%}
  {%- assign tab_count = tab_count | plus: 1 -%}
  {%- capture this_nav -%}
    <input type="radio" name="product-tabs-{{ section.id }}" id="product-tab-{{ section.id }}-{{ tab_count }}" class="product-tabs__radio"{% if tab_count == 1 %} checked{% endif %}>
    <label class="product-tabs__label" for="product-tab-{{ section.id }}-{{ tab_count }}">Description</label>
  {%- endcapture -%}
  {%- assign tabs_nav = tabs_nav | append: this_nav -%}
  {%- capture this_panel -%}
    <div class="product-tabs__panel" id="product-panel-{{ section.id }}-{{ tab_count }}">{{ product.description }}</div>
  {%- endcapture -%}
  {%- assign tabs_panels = tabs_panels | append: this_panel -%}
  {%- capture this_style -%}
    .product-tabs:has(#product-tab-{{ section.id }}-{{ tab_count }}:checked) #product-panel-{{ section.id }}-{{ tab_count }} { display: block; }
  {%- endcapture -%}
  {%- assign tabs_style = tabs_style | append: this_style -%}
{%- endif -%}

