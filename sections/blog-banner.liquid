<section class="shop-banner shop-banner--plain">
  <div class="container">
    <h1 class="shop-banner__heading">{{ blog.title }}</h1>
    {%- if blog.description != blank -%}
      <div class="shop-banner__text">{{ blog.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog banner",
  "settings": [],
  "presets": [
    {
      "name": "Blog banner"
    }
  ]
}
{% endschema %}
