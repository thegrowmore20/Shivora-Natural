{%- comment -%}
  Reads the "Product Short Videos" metafield — product.metafields.custom.product_short_videos,
  a list of YouTube (Shorts) URLs — instead of uploaded video files. Each
  card shows a YouTube thumbnail only; the real embed (iframe) is created on
  click via assets/global.js (YouTubeFacade), so nothing YouTube-related
  loads until a visitor actually presses play. Section hides itself entirely
  when the field is empty on a given product.
{%- endcomment -%}
{%- assign short_video_urls = product.metafields.custom.product_short_videos.value -%}
{%- if short_video_urls != blank -%}
  <section class="brand-story product-youtube">
    <div class="container">
      <h2 class="section-heading" style="margin-bottom:0;">{{ section.settings.heading | default: 'Watch on YouTube' }}</h2>
      {%- if section.settings.channel_handle != blank -%}
        <p class="instagram-section__handle product-youtube__handle">
          {% render 'icon', name: 'youtube' %} {{ section.settings.channel_handle }}
        </p>
      {%- endif -%}

      <div class="brand-story__reels product-youtube__reels">
        {%- for video_url in short_video_urls -%}
          {%- assign video_id = video_url | split: '?' | first | split: '/' | last -%}
          {%- if video_id != blank -%}
            <button type="button" class="reel-card reel-card--youtube" data-youtube-facade data-video-id="{{ video_id }}" aria-label="Play video">
              <img
                class="reel-card__media reel-card__poster"
                src="https://img.youtube.com/vi/{{ video_id }}/hqdefault.jpg"
                alt=""
                loading="lazy"
              >
              <span class="reel-card__play">{% render 'icon', name: 'play' %}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.button_label != blank -%}
        <p class="product-youtube__cta">
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--dark">{{ section.settings.button_label }}</a>
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product YouTube reels",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Watch on YouTube"
    },
    {
      "type": "text",
      "id": "channel_handle",
      "label": "Channel handle",
      "default": "@shivoranatural"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Product YouTube reels"
    }
  ]
}
{% endschema %}
