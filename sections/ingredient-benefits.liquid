<section class="ingredient-benefits">
  <div class="container container--narrow">
    <div class="ingredient-benefits__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.content != blank -%}
        <div class="ingredient-benefits__text">{{ section.settings.content }}</div>
      {%- endif -%}
    </div>

    {%- assign rows = section.blocks | where: 'type', 'row' -%}
    {%- if rows.size > 0 -%}
      <div class="ingredient-benefits__table-wrap">
        <table class="ingredient-benefits__table">
          <thead>
            <tr>
              <th>{{ section.settings.column_1_label | default: 'Ingredients' }}</th>
              <th>{{ section.settings.column_2_label | default: 'Beauty Gains' }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in rows -%}
              <tr {{ block.shopify_attributes }}>
                <td><strong>{{ block.settings.ingredient }}</strong></td>
                <td>{{ block.settings.benefit }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredient benefits table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Key Ingredients & Their Beauty Gains"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Every Shivora formula is powered by dermatologist-approved ingredients, each chosen for a specific skin benefit you can actually see and feel.</p>"
    },
    {
      "type": "text",
      "id": "column_1_label",
      "label": "Column 1 label",
      "default": "Ingredients"
    },
    {
      "type": "text",
      "id": "column_2_label",
      "label": "Column 2 label",
      "default": "Beauty Gains"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "ingredient",
          "label": "Ingredient",
          "default": "Ingredient Name"
        },
        {
          "type": "textarea",
          "id": "benefit",
          "label": "Beauty gain",
          "default": "Describe the benefit for the skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient benefits table",
      "blocks": [
        { "type": "row", "settings": { "ingredient": "Snail Mucin", "benefit": "Hydrates and repairs skin for a smoother, healthier glow." } },
        { "type": "row", "settings": { "ingredient": "Hyaluronic Acid", "benefit": "Locks in moisture to keep skin plump, soft, and hydrated." } },
        { "type": "row", "settings": { "ingredient": "Niacinamide", "benefit": "Brightens uneven skin and smooths visible texture." } },
        { "type": "row", "settings": { "ingredient": "Allantoin", "benefit": "Soothes dry, stressed skin and leaves it feeling softer." } },
        { "type": "row", "settings": { "ingredient": "Panthenol", "benefit": "Moisturizes and supports a stronger, healthier skin barrier." } },
        { "type": "row", "settings": { "ingredient": "Betaine", "benefit": "Maintains hydration for smooth, refreshed-looking skin." } },
        { "type": "row", "settings": { "ingredient": "Vitamin E", "benefit": "Nourishes the skin and supports a soft, radiant appearance." } }
      ]
    }
  ]
}
{% endschema %}
