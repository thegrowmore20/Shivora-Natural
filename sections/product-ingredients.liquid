{%- comment -%}
  product.metafields.custom.ingredients is a rich text field, so .value
  returns its raw serialized structure rather than plain text. Rendering it
  through metafield_tag (which turns rich text into real HTML) and then
  strip_html gives back the clean, comma-separated ingredient list the
  merchant actually typed, which we then split into chips.
{%- endcomment -%}
{%- assign ingredients_field = product.metafields.custom.ingredients -%}
{%- assign ingredients_raw = ingredients_field | metafield_tag | strip_html | strip_newlines | strip -%}
{%- if ingredients_raw != blank -%}
  <section class="product-ingredients">
    <div class="container container--narrow">
      <h2 class="section-heading">{{ section.settings.heading | default: 'Ingredients' }}</h2>
      <ul class="product-ingredients__list">
        {%- assign ingredient_list = ingredients_raw | split: ',' -%}
        {%- for ingredient in ingredient_list -%}
          {%- assign ingredient_name = ingredient | strip -%}
          {%- if ingredient_name != blank -%}
            <li class="product-ingredients__item">{{ ingredient_name }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients"
    }
  ],
  "presets": [
    {
      "name": "Product ingredients"
    }
  ]
}
{% endschema %}
