<section class="features-section">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading | default: 'Why Pakistanis Trust Shivora for Skincare' }}</h2>

    {%- assign left_blocks = section.blocks | where: 'type', 'feature' | slice: 0, 2 -%}
    {%- assign right_blocks = section.blocks | where: 'type', 'feature' | slice: 2, 2 -%}

    <div class="features-grid">
      <div class="features-col">
        {%- for block in left_blocks -%}
          <div class="feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="features-media">
        <span class="features-media__frame"></span>
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy' }}
        {%- endif -%}
      </div>

      <div class="features-col">
        {%- for block in right_blocks -%}
          <div class="feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Features with image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Pakistanis Trust Shivora for Skincare"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features with image",
      "blocks": [
        { "type": "feature", "settings": { "title": "100% Organic Ingredients", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Made for Local Skin Needs", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Easy to use", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } },
        { "type": "feature", "settings": { "title": "Results You Can See", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } }
      ]
    }
  ]
}
{% endschema %}
