<section class="collections-section">
  <div class="container">
    <h2 class="section-heading">{{ section.settings.heading | default: 'Top Collections' }}</h2>

    <div class="collections-grid">
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        <a class="collection-card" href="{{ collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="collection-card__media">
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {%- elsif collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </span>
          <span class="collection-card__title">{{ block.settings.title | default: collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Top Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom title (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection", "settings": { "title": "Shop All" } },
        { "type": "collection", "settings": { "title": "Clearance Sale" } },
        { "type": "collection", "settings": { "title": "Glow Set Bundle" } },
        { "type": "collection", "settings": { "title": "Offers" } }
      ]
    }
  ]
}
{% endschema %}
