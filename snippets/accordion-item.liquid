{%- comment -%}
  Accepts: title (string), content (string, HTML), open (boolean)
{%- endcomment -%}
<details class="accordion-item"{% if open %} open{% endif %}>
  <summary class="accordion-item__summary">
    <span>{{ title }}</span>
    <span class="accordion-item__icon">
      <span class="accordion-item__icon-plus">{% render 'icon', name: 'plus' %}</span>
      <span class="accordion-item__icon-minus">{% render 'icon', name: 'minus' %}</span>
    </span>
  </summary>
  <div class="accordion-item__content">
    {{ content }}
  </div>
</details>
